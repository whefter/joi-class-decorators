{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "types": [],
    "sourceMap": false,
    "declaration": true,
    "removeComments": true,
    "useUnknownInCatchVariables": true,
    "noUnusedLocals": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.spec.ts"]
}
